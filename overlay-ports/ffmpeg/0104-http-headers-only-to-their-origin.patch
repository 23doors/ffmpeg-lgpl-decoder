+        headers = s->headers;
+    else if (s->headers && s->headers_origin &&
+             url_origin(origin, sizeof(origin), s->headers_origin) >= 0)
+        av_log(h, AV_LOG_VERBOSE, "Custom headers not sent to another origin than %s\n",
+               s->headers_origin);
+    else if (s->headers && !s->headers_origin_unknown_logged) {
+        av_log(h, AV_LOG_WARNING, "Custom headers not sent: no origin for them "
+               "(headers_origin, http[s]://host[:port], or the URL could not be read)\n");
+        s->headers_origin_unknown_logged = 1;
+    }
+
     /* send http header */
     post = h->flags & AVIO_FLAG_WRITE;
 
@@ -1584,19 +1666,19 @@ static int http_connect(URLContext *h, const char *path, const char *local_path,
     if (post && s->chunked_post)
