+/* A URL's origin (RFC 6454): scheme, host and port, lower case, with the
+ * scheme's default port when none is given; an IPv6 host in brackets, as in
+ * the URL (av_url_split() drops them), so that the origin reads back the
+ * same. Only http and https have one here: "host:8096", with no scheme,
+ * reads as the scheme "host" and is no origin. */
+static int url_origin(char *buf, int size, const char *url)
+{
+    char proto[16], host[1024];
+    int port = -1;
+
+    av_url_split(proto, sizeof(proto), NULL, 0, host, sizeof(host), &port,
+                 NULL, 0, url);
+    if (!host[0] || (av_strcasecmp(proto, "http") && av_strcasecmp(proto, "https")))
+        return AVERROR(EINVAL);
+    if (port < 0)
+        port = !av_strcasecmp(proto, "https") ? 443 : 80;
+    for (char *c = proto; *c; c++)
+        *c = av_tolower(*c);
+    for (char *c = host; *c; c++)
+        *c = av_tolower(*c);
+    snprintf(buf, size, strchr(host, ':') ? "%s://[%s]:%d" : "%s://%s:%d",
+             proto, host, port);
+    return 0;
+}
+
+/* The custom headers' origin, unless the caller named one: that of the URL
+ * the request was made for, before any redirect (s->uri; a new request on a
+ * kept-alive connection sets it to its own URL). */
+static int set_default_headers_origin(HTTPContext *s)
+{
+    char origin[1100];
+
+    if (s->headers_origin || !s->uri ||
+        url_origin(origin, sizeof(origin), s->uri) < 0)
+        return 0;
+    s->headers_origin = av_strdup(origin);
+    return s->headers_origin ? 0 : AVERROR(ENOMEM);
+}
+
+/* Whether the custom headers go with a request for url: only to their
+ * origin, so that a token or cookie they carry reaches no other server (a
+ * CDN, an ad server) through a redirect or a playlist's address. Without a
+ * known origin they go nowhere. */
+static int headers_go_to(const HTTPContext *s, const char *url)
+{
+    char want[1100], have[1100];
+
+    if (!s->headers_origin ||
+        url_origin(want, sizeof(want), s->headers_origin) < 0 ||
+        url_origin(have, sizeof(have), url) < 0)
+        return 0;
+    return !strcmp(want, have);
+}
+
 static int http_connect(URLContext *h, const char *path, const char *local_path,
                         const char *hoststr, const char *auth,
                         const char *proxyauth);
@@ -789,6 +847,12 @@ static int http_open(URLContext *h, const char *uri, int flags,
     if (!s->uri)
         return AVERROR(ENOMEM);
 
+    /* Unless the caller named it, the custom headers' origin is that of the
+     * URL opened, not of where a redirect leads; set here so that it is
+     * exported to the connections a demuxer opens with these options. */
+    if (s->headers && (ret = set_default_headers_origin(s)) < 0)
+        return ret;
+
     if (options)
         av_dict_copy(&s->chained_options, *options, 0);
 
@@ -1538,9 +1602,27 @@ static int http_connect(URLContext *h, const char *path, const char *local_path,
     uint64_t off = s->off;
     const char *method;
     int send_expect_100 = 0;
+    const char *headers = NULL;
