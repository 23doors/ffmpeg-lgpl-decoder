     /* The error the playlist failed with for good, kept until a seek. */
     int read_error;
+    /* A segment of the playlist was read to its end, and no data of the next
+     * one, which follows it in the playlist's byte stream, was read yet. */
+    int segment_boundary;
 
     /* Currently active Media Initialization Section */
     struct segment *cur_init_section;
@@ -2044,6 +2047,17 @@ static int segment_failure_is_final(HLSContext *c, struct playlist *v)
             av_gettime_relative() - v->segment_error_time >= live_reload_timeout(v, c));
 }
 
+static int starts_as_webvtt(const uint8_t *buf, int size)
+{
+    if (size >= 3 && !memcmp(buf, "\xEF\xBB\xBF", 3)) {
+        buf  += 3;
+        size -= 3;
+    }
+    return size >= 6 && !memcmp(buf, "WEBVTT", 6) &&
+           (size == 6 || buf[6] == ' ' || buf[6] == '\t' ||
+            buf[6] == '\r' || buf[6] == '\n');
+}
