http: a chunk-size line cut by an interrupt is read on

In chunked transfer encoding, http_buf_read() read each chunk-size line
into a local buffer with http_get_line(). When the caller's interrupt
callback stopped the refill of http's buffer in the middle of that line
(AVERROR_EXIT), the characters read so far were lost with the local
buffer, and the next read took the rest of the line for the size: a
wrong chunk size, or 0, which ends the reply early. With 0099, which
reads an hls segment on after an interrupt, a chunked segment lost its
rest or read garbage.

Keep the line read so far in the context and go on with it on the next
read; it is reset with the reply's headers. Replies with a Content-Length
are not affected.

The lines after the last chunk (the reply's end on a connection kept for
the next request, as hls's segments are) are read the same way, up to the
blank line that ends them: an interrupt in them left their CR LF unread,
and a trailer field (RFC 9112 7.1.2) ended the reply at its first line,
so the next reply on the connection took the rest for its status line.

diff --git a/libavformat/http.c b/libavformat/http.c
--- a/libavformat/http.c
+++ b/libavformat/http.c
@@ -78,6 +78,14 @@ typedef struct HTTPContext {
     /* Used if "Transfer-Encoding: chunked" otherwise -1. */
     uint64_t chunksize;
     int chunkend;
+    /* The chunk-size line read so far: kept when a read stops inside it (the
+     * caller's interrupt callback), so that the next read goes on with it. */
+    char chunk_line[32];
+    int chunk_line_len;
+    /* The last chunk was read and the line after it is still to come (a
+     * reply on a connection kept for the next request), read as the size
+     * line is. */
+    int chunk_trailer;
     uint64_t off, end_off, filesize, range_end;
     char *uri;
     char *location;
@@ -1511,6 +1519,8 @@ static int http_read_header(URLContext *h)
     av_freep(&s->new_location);
     s->expires = 0;
     s->chunksize = UINT64_MAX;
+    s->chunk_line_len = 0;
+    s->chunk_trailer = 0;
     s->filesize_from_content_range = UINT64_MAX;
 
     for (;;) {
@@ -1807,12 +1817,33 @@ static int http_buf_read(URLContext *h, uint8_t *buf, int size)
         }
         if (!s->chunksize) {
             char line[32];
-            int err;
-
-            do {
-                if ((err = http_get_line(s, line, sizeof(line))) < 0)
-                    return err;
-            } while (!*line);    /* skip CR LF from last chunk */
+            int ch;
+
+            /* http_get_line(), but the line so far is kept in the context:
+             * a read that stops inside it (an interrupt) loses none of it. */
+            for (;;) {
+                if ((ch = http_getc(s)) < 0)
+                    return ch;
+                if (ch != '\n') {
+                    if (s->chunk_line_len < sizeof(s->chunk_line) - 1)
+                        s->chunk_line[s->chunk_line_len++] = ch;
+                    continue;
+                }
+                if (s->chunk_line_len && s->chunk_line[s->chunk_line_len - 1] == '\r')
+                    s->chunk_line_len--;
+                memcpy(line, s->chunk_line, s->chunk_line_len);
+                line[s->chunk_line_len] = '\0';
+                s->chunk_line_len = 0;
+                if (s->chunk_trailer) {
+                    if (*line)
+                        continue;    /* a trailer field: skipped */
+                    s->chunk_trailer = 0;
+                    s->chunkend = 1;
+                    return 0;
+                }
+                if (*line)
+                    break;       /* skip CR LF from last chunk */
+            }
 
             s->chunksize = strtoull(line, NULL, 16);
 
@@ -1821,9 +1852,9 @@ static int http_buf_read(URLContext *h, uint8_t *buf, int size)
                     s->chunksize);
 
             if (!s->chunksize && s->multiple_requests) {
-                http_get_line(s, line, sizeof(line)); // read empty chunk
-                s->chunkend = 1;
-                return 0;
+                /* the line after it, kept across an interrupt as this one */
+                s->chunk_trailer = 1;
+                return http_buf_read(h, buf, size);
             }
             else if (!s->chunksize) {
                 av_log(h, AV_LOG_DEBUG, "Last chunk received, closing conn\n");
