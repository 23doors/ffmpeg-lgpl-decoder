+static int matroska_io_failed(MatroskaDemuxContext *matroska, int ret)
+{
+    return ret < 0 && ret != AVERROR_INVALIDDATA &&
+           (ret == AVERROR_EXIT || matroska->ctx->pb->error < 0);
+}
+
+/* Whether an I/O failure may pass when the input's network is back. */
+static int matroska_io_error_is_transient(int err)
