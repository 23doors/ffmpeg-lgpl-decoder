+           err == AVERROR(ETIMEDOUT) || err == AVERROR(ECONNRESET) ||
+           err == AVERROR(ECONNREFUSED) || err == AVERROR(EPIPE) ||
+#ifdef ECONNABORTED
+           err == AVERROR(ECONNABORTED) ||
+#endif
+#ifdef ENETDOWN
+           err == AVERROR(ENETDOWN) ||
+#endif
+#ifdef ENETUNREACH
+           err == AVERROR(ENETUNREACH) ||
+#endif
+#ifdef EHOSTUNREACH
+           err == AVERROR(EHOSTUNREACH) ||
+#endif
