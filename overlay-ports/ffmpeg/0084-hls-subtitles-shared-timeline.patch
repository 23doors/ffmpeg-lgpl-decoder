avformat/hls: keep subtitle playlists on the shared timeline, and the cue shown at the seek target

Backport of FFmpeg commits 609972d4cc and 729de963f9 by Kacper
Michajłow, as committed upstream; the tests they add are left out.

The cue times of a subtitle playlist are on the MPEG-TS timeline, and
the first cue of a segment says nothing about where the segment starts,
so use an offset of 0 instead of deriving one from the first cue, which
made a seek skip the cues within that offset.

Discard the cues of a subtitle playlist by their end time when seeking
or when the playlist is enabled during playback, so a cue that is on
screen at the target is delivered instead of the next one starting after
it.

diff --git a/libavformat/hls.c b/libavformat/hls.c
index 9917f46..8b11860 100644
--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -3317,7 +3317,11 @@ retry:
                     fill_timing_for_id3_timestamped_stream(pls);
                 }
 
-                if (pls->pkt->dts != AV_NOPTS_VALUE &&
+                if (pls->is_subtitle) {
+                    /* the cues are on the shared timeline */
+                    if (pls->ts_offset == AV_NOPTS_VALUE)
+                        pls->ts_offset = 0;
+                } else if (pls->pkt->dts != AV_NOPTS_VALUE &&
                     (pls->ts_offset == AV_NOPTS_VALUE ||
                      (!c->first_timestamp_locked &&
                       c->first_timestamp_pls == pls &&
@@ -3346,7 +3350,8 @@ retry:
                         if (delta > 0 && delta <= pls->target_duration) {
                             c->first_timestamp = ts;
                             for (int k = 0; k < c->n_playlists; k++)
-                                if (c->playlists[k]->ts_offset != AV_NOPTS_VALUE)
+                                if (c->playlists[k]->ts_offset != AV_NOPTS_VALUE &&
+                                    !c->playlists[k]->is_subtitle)
                                     c->playlists[k]->ts_offset += delta;
                             adjusted = 1;
                         }
@@ -3407,6 +3412,13 @@ retry:
                         pls->seek_timestamp = AV_NOPTS_VALUE;
                         break;
                     }
+                    /* a cue still shown at the target is delivered, the cues
+                     * after it may still have ended before the target */
+                    if (pls->is_subtitle && pls->pkt->duration > 0 &&
+                        av_rescale_q_rnd(pls->pkt->dts + pls->pkt->duration, tb,
+                                         AV_TIME_BASE_Q, AV_ROUND_DOWN) >
+                        pls->seek_timestamp)
+                        break;
                 }
                 av_packet_unref(pls->pkt);
             }
