+     * AV_NOPTS_VALUE: none), that video stream (subdemuxer index), and
+     * whether the other streams are still held back to the position. */
+    int64_t catchup_ts;
+    int64_t catchup_end;
+    int catchup_stream;
+    int catchup_others;
 
     /* Renditions associated with this playlist, if any.
      * Alternative rendition playlists have a single rendition associated
@@ -466,6 +475,7 @@ static struct playlist *new_playlist(HLSContext *c, const char *url,
     pls->ts_offset = AV_NOPTS_VALUE;
     pls->last_cue_pts = AV_NOPTS_VALUE;
     pls->seek_timestamp = AV_NOPTS_VALUE;
+    pls->catchup_ts = AV_NOPTS_VALUE;
     pls->first_read_seq_no = -1;
     pls->anchor_ts = AV_NOPTS_VALUE;
     pls->anchor_pending_seq_no = -1;
@@ -2846,6 +2856,54 @@ static int find_timestamp_in_playlist(HLSContext *c, struct playlist *pls,
     return 0;
 }
 
+/* The playlist's needed video stream (its subdemuxer index), or -1. */
+static int needed_video_stream(const struct playlist *pls)
+{
+    for (int j = 0; j < pls->n_main_streams; j++) {
+        const AVStream *st = pls->main_streams[j];
+        if (st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO &&
+            !(st->disposition & AV_DISPOSITION_ATTACHED_PIC) &&
+            st->discard < AVDISCARD_ALL)
+            return j;
+    }
+    return -1;
+}
+
+/* Start a VOD playlist's video stream (vid) at the keyframe that begins the
+ * segment holding timestamp, not at the first packet at timestamp: the
+ * frames after a keyframe cannot be decoded without it (a hardware decoder
+ * fails on them, a software one hides them until the next keyframe, up to a
+ * GOP later). As a seek on the playlist's own video stream does (the cutoff
+ * a segment early: the keyframe's DTS may be below the EXTINF-derived start,
+ * and reading starts at the segment anyway), so the caller gets up to a
+ * segment of frames before timestamp, which it drops as after any seek.
+ * A video stream with no keyframe flag before timestamp (a segment that
+ * does not start with one, an intra-refresh stream) starts at timestamp,
+ * and the playlist's other streams do, as before. Returns 0 when timestamp
+ * is past the playlist's end. */
+static int catch_up_from_keyframe(HLSContext *c, struct playlist *pls, int vid,
+                                  int64_t timestamp)
+{
+    int64_t offset = pls->ts_offset != AV_NOPTS_VALUE ? pls->ts_offset : 0;
+    int64_t seq_no, seg_start, idx, duration;
+
+    if (!find_timestamp_in_playlist(c, pls, timestamp, &seq_no, &seg_start))
+        return 0;
+    idx = seq_no - pls->start_seq_no;
+    if (idx < 0 || idx >= pls->n_segments)
+        return 0;
+    duration = pls->segments[idx]->duration;
+    pls->cur_seq_no        = seq_no;
+    pls->seek_timestamp    = av_sat_add64(av_sat_sub64(seg_start, duration), offset);
+    pls->seek_flags        = AVSEEK_FLAG_BACKWARD;
+    pls->seek_stream_index = vid;
+    pls->catchup_stream    = vid;
+    pls->catchup_ts        = av_sat_add64(timestamp, offset);
+    pls->catchup_end       = av_sat_add64(av_sat_add64(seg_start, duration), offset);
+    pls->catchup_others    = 1;
+    return 1;
+}
+
 static int64_t select_cur_seq_no(HLSContext *c, struct playlist *pls)
 {
     int64_t seq_no;
@@ -3431,12 +3489,21 @@ static int recheck_discard_flags(AVFormatContext *s, int first)
             pls->segment_boundary = 0;
             pls->pb.pub.eof_reached = 0;
             pls->pb.pub.error = 0;
+            pls->catchup_ts = AV_NOPTS_VALUE;
             if (c->cur_timestamp != AV_NOPTS_VALUE) {
-                /* catch up */
-                pls->seek_timestamp = av_sat_add64(c->cur_timestamp,
-                    pls->ts_offset != AV_NOPTS_VALUE ? pls->ts_offset : 0);
-                pls->seek_flags = AVSEEK_FLAG_ANY;
-                pls->seek_stream_index = -1;
+                /* A VOD playlist that brings a video stream (another
+                 * variant, after a seek or during playback) starts it at its
+                 * segment's keyframe; a seek's keyed cutoff on it would be
+                 * replaced here. */
+                int vid = needed_video_stream(pls);
+                if (vid < 0 || !pls->finished ||
+                    !catch_up_from_keyframe(c, pls, vid, c->cur_timestamp)) {
+                    /* catch up */
+                    pls->seek_timestamp = av_sat_add64(c->cur_timestamp,
+                        pls->ts_offset != AV_NOPTS_VALUE ? pls->ts_offset : 0);
+                    pls->seek_flags = AVSEEK_FLAG_ANY;
+                    pls->seek_stream_index = -1;
+                }
             }
             av_log(s, AV_LOG_INFO, "Now receiving playlist %d, segment %"PRId64"\n", i, pls->cur_seq_no);
         } else if ((first || pls->is_subtitle) && !cur_needed && pls->needed) {
@@ -3705,6 +3772,27 @@ retry:
                     }
                 }
 
+                /* After a catch-up from the video's keyframe, the other
+                 * streams start at the position, as they did before (a muxed
+                 * variant's audio would go back by up to a segment): until
+                 * the first of them gets there, or the video past its
+                 * segment. A packet without a timestamp then is the rest of
+                 * a PES whose start was dropped. */
+                if (pls->catchup_ts != AV_NOPTS_VALUE && pls->catchup_others) {
+                    int64_t t = pls->pkt->dts == AV_NOPTS_VALUE ? AV_NOPTS_VALUE :
+                                av_rescale_q_rnd(pls->pkt->dts, get_timebase(pls),
+                                                 AV_TIME_BASE_Q, AV_ROUND_DOWN);
+                    if (pls->pkt->stream_index == pls->catchup_stream) {
+                        if (t != AV_NOPTS_VALUE && t >= pls->catchup_end)
+                            pls->catchup_others = 0;
+                    } else if (t == AV_NOPTS_VALUE || t < pls->catchup_ts) {
+                        av_packet_unref(pls->pkt);
+                        continue;
+                    } else {
+                        pls->catchup_others = 0;
+                    }
+                }
+
                 if (pls->seek_timestamp == AV_NOPTS_VALUE)
                     break;
 
@@ -3725,6 +3813,13 @@ retry:
                         pls->seek_timestamp = AV_NOPTS_VALUE;
