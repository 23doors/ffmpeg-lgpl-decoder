                     if (pls->is_subtitle && pls->pkt->duration > 0 &&
@@ -4053,6 +4148,7 @@ static int hls_read_seek(AVFormatContext *s, int stream_index,
         /* Reset the init segment so it's re-fetched and served appropriately */
         pls->cur_init_section = NULL;
         pls->segment_boundary = 0;
+        pls->catchup_ts = AV_NOPTS_VALUE;
 
         /* The discard in hls_read_packet compares this playlist's packet DTS
          * against seek_timestamp, but seek_timestamp is on c->first_timestamp's
@@ -4094,6 +4190,19 @@ static int hls_read_seek(AVFormatContext *s, int stream_index,
                 pls->seek_timestamp = av_sat_sub64(pls->seek_timestamp, pls->segments[idx]->duration);
         }
 
+        if (pls != seek_pls && pls->seek_timestamp != AV_NOPTS_VALUE &&
+            (flags & AVSEEK_FLAG_BACKWARD) && !(flags & AVSEEK_FLAG_ANY)) {
+            /* A video stream of another playlist (the seek was on an audio
+             * stream, or two video renditions are read) starts at its
+             * segment's keyframe as the seek playlist's does, not on the
+             * frames after it. */
+            int vid = needed_video_stream(pls);
+            if (vid >= 0 && catch_up_from_keyframe(c, pls, vid, seek_timestamp)) {
+                pls->last_seq_no = pls->cur_seq_no;
+                continue;
+            }
+        }
+
         if (pls != seek_pls) {
             /* set closest segment seq_no for playlists not handled above */
             find_timestamp_in_playlist(c, pls, seek_timestamp, &pls->cur_seq_no, NULL);
