+/* A reload refused with a client error (4xx other than 429) will not pass on a
+ * retry: the playlist is gone or not ours to read. A network error, a timeout,
+ * a server error or a garbled answer may. */
+static int reload_error_is_transient(int err)
+{
+    switch (err) {
+    case AVERROR_HTTP_BAD_REQUEST:
+    case AVERROR_HTTP_UNAUTHORIZED:
+    case AVERROR_HTTP_FORBIDDEN:
+    case AVERROR_HTTP_NOT_FOUND:
+    case AVERROR_HTTP_OTHER_4XX:
+        return 0;
+    default:
+        return 1;
+    }
+}
+
+/* How long a live playlist whose reloads fail is played on from the segments it
+ * listed last before the failure is returned. */
+static int64_t live_reload_timeout(const struct playlist *pls, const HLSContext *c)
+{
+    if (c->live_reload_timeout >= 0)
+        return c->live_reload_timeout;
+    return FFMAX(3 * pls->target_duration, 20 * AV_TIME_BASE);
+}
+
 static int reload_playlist(struct playlist *v, HLSContext *c)
 {
