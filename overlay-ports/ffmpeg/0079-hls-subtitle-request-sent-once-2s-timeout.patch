+/* A subtitle playlist is read in line with the audio and video, so a
+ * subtitle request that stalls holds them all, through every retry. Its
+ * segments and reloads are asked for once, without http's retries, and given
+ * up after SUBTITLE_IO_TIMEOUT without data (less if the input's I/O timeout
+ * is shorter): a failed segment is skipped, a failed reload tried again after
+ * a reload interval, until the subtitle playlist failed for good
+ * (read_subtitle_packet()). */
+#define SUBTITLE_IO_TIMEOUT (2 * AV_TIME_BASE)
+
+static void set_subtitle_io_opts(HLSContext *c, AVDictionary **opts)
+{
+    int64_t timeout = SUBTITLE_IO_TIMEOUT;
+    AVDictionaryEntry *e = av_dict_get(c->avio_opts, "rw_timeout", NULL, 0);
+
+    if (e) {
+        int64_t input_timeout = strtoll(e->value, NULL, 10);
+        if (input_timeout > 0 && input_timeout < timeout)
+            timeout = input_timeout;
+    }
+    av_dict_set_int(opts, "rw_timeout", timeout, 0);
+    av_dict_set_int(opts, "reconnect_max_retries", 0, 0);
+}
