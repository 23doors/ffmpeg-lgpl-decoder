avformat/hls: keep retrying a VOD subtitle playlist's failed segments

0162 asks for a failed VOD subtitle segment once more, then the next,
each min(target duration, 4 s) later, and the live tolerance
(live_reload_timeout: three target durations, at least 20 s) ended the
track. A server extracting a long film's subtitles on the first request
(Jellyfin, a cold 2 h film: 30 s and more on a loaded host) fails its
segment requests for longer than that, and the track was gone for the
rest of the film.

A VOD subtitle playlist no longer fails on segments that do not come.
Its tries wait min(target duration, 4 s) (at least 1 s), as before, for
as long as the live tolerance would have kept the track, each segment
asked for twice before the next, so a short extraction loses no more
cues than with 0162 alone. After that each wait is twice the last, up
to subtitle_vod_retry_max (30 s by default, at least 1 s), for as long
as the media plays, and each try asks for the media's segment rather
than the next one in order: a server back after minutes is not asked
for every segment of them, behind the media and inline with its reads.
A request still holds the media 2 s at most.

An answer whose body stops (its read given up after 2 s) failed nothing:
the reader moved on to the next segment at once, each such answer
holding the media 2 s with no wait between them. It now fails as a
request does: its cues so far are kept, and it is tried again on the
same schedule. The failures count from the first one until a segment is
read through (an open alone no longer resets them), and a seek or a
reselection starts afresh.

Only a local error (out of memory, a bug) ends a VOD subtitle track; a
4xx or a garbled answer is tried on too. The tolerance still ends a live
one. A slow server costs cues, not the track.

subtitle_vod_retry_max is the probe.

Our own patch.

diff --git a/libavformat/hls.c b/libavformat/hls.c
--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -173,6 +173,9 @@
     int64_t subtitle_retry_time;
     /* A VOD subtitle playlist's failed segment was asked for once more. */
     int subtitle_segment_retried;
+    /* How long a VOD subtitle playlist waited before its last try (0: its
+     * last segment opened). */
+    int64_t subtitle_retry_wait;
     /* A VOD subtitle playlist starts at the media's segment at its next read
      * (opened, selected again, or after a seek). */
     int subtitle_follow_media;
@@ -330,6 +333,7 @@
     int seg_skip;
     int64_t live_reload_timeout;
     int subtitle_follow_media;      /* VOD subtitle playlists read along the media's segment */
+    int64_t subtitle_vod_retry_max; /* the longest wait between a VOD subtitle playlist's tries */
     int vod_x_start;                /* a VOD playlist starts at its #EXT-X-START */
     int64_t master_start_offset;    /* the master's #EXT-X-START, if master_time_offset_flag */
     int master_time_offset_flag;
@@ -2517,6 +2521,25 @@
     return ret;
 }
 
+/* A subtitle segment that did not come (its request failed, or its answer
+ * stopped): it is skipped (read_subtitle_packet()), until segments of a live
+ * playlist have failed for as long as its reloads may: then the playlist
+ * failed. A VOD playlist's are tried on, ever less often, for as long as the
+ * media plays: a server extracting a long film's subtitles on the first
+ * request fails them for a minute or more. The failures count from the first
+ * one until a segment is read through. */
+static void subtitle_segment_failed(HLSContext *c, struct playlist *v,
+                                    int64_t start, int ret)
+{
+    if (!v->segment_error_time)
+        v->segment_error_time = start;
+    if (error_is_local(ret) ||
+        (!v->finished &&
+         av_gettime_relative() - v->segment_error_time >= live_reload_timeout(v, c)))
+        v->read_error = ret;
+    v->subtitle_segment_failed = 1;
+}
+
 static int read_data_subtitle_segment(void *opaque, uint8_t *buf, int buf_size)
 {
     struct playlist *v = opaque;
@@ -2540,23 +2563,24 @@
                 return AVERROR_EXIT;
             av_log(v->parent, AV_LOG_WARNING, "Failed to open segment of playlist %d\n",
                    v->index);
-            /* A failed segment is skipped (read_subtitle_packet()), until
-             * segments have failed for as long as a live playlist's reloads
-             * may: then the playlist failed. */
-            if (!v->segment_error_time)
-                v->segment_error_time = open_start;
-            if (error_is_local(ret) ||
-                av_gettime_relative() - v->segment_error_time >= live_reload_timeout(v, c))
-                v->read_error = ret;
-            v->subtitle_segment_failed = 1;
+            subtitle_segment_failed(c, v, open_start, ret);
             return ret;
         }
-        v->segment_error_time = 0;
         if (v->first_read_seq_no < 0)
             v->first_read_seq_no = v->cur_seq_no;
     }
 
-    return read_from_url(v, seg, buf, buf_size);
+    ret = read_from_url(v, seg, buf, buf_size);
+    /* An answer that stops (its read given up after 2 s) failed as a
+     * request does: its cues so far are kept, and it is asked for again
+     * (a cue that comes twice arrives once). */
+    if (ret < 0 && ret != AVERROR_EOF && ret != AVERROR_EXIT &&
+        !v->subtitle_segment_failed) {
+        av_log(v->parent, AV_LOG_WARNING, "Failed to read segment of playlist %d: %s\n",
+               v->index, av_err2str(ret));
+        subtitle_segment_failed(c, v, av_gettime_relative(), ret);
+    }
+    return ret;
 }
 
 static int nested_io_open(AVFormatContext *s, AVIOContext **pb, const char *url,
@@ -2742,8 +2766,11 @@
     v->last_cue_pts = pkt->pts;
 }
 
-/* The longest wait before a failed VOD subtitle segment is asked for again. */
-#define SUBTITLE_VOD_RETRY_MAX (4 * AV_TIME_BASE)
+/* The longest wait before a failed VOD subtitle segment is asked for again
+ * while its failures are younger than the live tolerance. */
+#define SUBTITLE_VOD_RETRY_FIRST (4 * AV_TIME_BASE)
+/* The shortest: a playlist without a target duration waits that long too. */
+#define SUBTITLE_VOD_RETRY_MIN AV_TIME_BASE
 
 /* The start of a segment on its playlist's own time line: the durations of
  * the segments before it. */
@@ -2900,8 +2927,16 @@
