+#define MOV_PRELOAD_MAX   (16 << 20)
+#define MOV_PRELOAD_ATOMS 32
+
+/* Reads the atoms from the position up to and with the next mdat's header
+ * into the I/O buffer, and seeks back: an interrupt from the caller's
+ * callback cuts the read here, before anything of them is parsed (a parse
+ * cut part way takes the missing bytes for zeros, and what it put in the
+ * index cannot be read again). Returns AVERROR_EXIT when the interrupt cut
+ * it, else 0 (the parse meets any other error or the end itself). Atoms
+ * past MOV_PRELOAD_MAX bytes or MOV_PRELOAD_ATOMS atoms, or of no stated
+ * size, are not preloaded. */
+static int mov_preload_root(AVIOContext *pb)
+{
+    int64_t start = avio_tell(pb), end = start, kept = 4096;
+    int cut = 0;
+
+    /* Only an input that cannot seek back: on one that can, the seeks here
+     * go to the protocol (http: a new connection) when the atoms span the
+     * buffer, and an interrupt's error stays in its context for good (hls
+     * alone clears it), so there is nothing to read again. */
+    if (pb->seekable & AVIO_SEEKABLE_NORMAL)
+        return 0;
+    /* the buffer keeps everything from start on */
+    if (ffio_ensure_seekback(pb, kept) < 0)
+        return 0;
+    for (int i = 0; i < MOV_PRELOAD_ATOMS; i++) {
+        uint8_t hdr[16];
+        uint64_t size;
+        int n, len;
+
+        if (end - start + 16 > kept) {
+            /* a larger window, from start again (doubled: a few times at most) */
+            while (end - start + 16 > kept)
+                kept *= 2;
+            if (avio_seek(pb, start, SEEK_SET) != start)
+                return AVERROR(EIO);
+            if (ffio_ensure_seekback(pb, kept) < 0)
+                break;
+        }
+        if (avio_tell(pb) != end && avio_seek(pb, end, SEEK_SET) != end) {
+            cut = pb->error == AVERROR_EXIT;
+            break;
+        }
+        n = avio_read(pb, hdr, 8);
+        len = n == 8 && AV_RB32(hdr) == 1 ? 16 : 8;
+        if (len == 16)
+            n += FFMAX(avio_read(pb, hdr + 8, 8), 0);
+        if (n < len) {
+            cut = pb->error == AVERROR_EXIT;
+            break;
+        }
+        size = len == 16 ? AV_RB64(hdr + 8) : AV_RB32(hdr);
+        if (AV_RL32(hdr + 4) == MKTAG('m','d','a','t') || size < len ||
+            size > (uint64_t)(MOV_PRELOAD_MAX - (end - start)))
+            break;
+        end += size;
+    }
+    if (avio_seek(pb, start, SEEK_SET) != start)
+        return AVERROR(EIO);
+    return cut ? AVERROR_EXIT : 0;
+}
+
