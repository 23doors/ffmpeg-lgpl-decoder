+/* Where a VOD playlist starts: the segment holding its #EXT-X-START offset
+ * on its time line (RFC 8216 4.4.2.2: a client SHOULD start there; a negative
+ * offset counts from the end, one past either end means that end), or its
+ * first one. A rendition without its own takes the first offset another
+ * playlist names (they share the time line), else the master's. PRECISE=YES
+ * is not taken: the start is the segment's, as with PRECISE=NO (a caller's
+ * own start, a seek, is exact). A transcode started at an
+ * offset (Plex) lists the whole film and answers the segments before the
+ * offset empty: read from the first one, the media's read walked through
+ * hundreds of them at the open, its position started at 0 at the offset,
+ * and seeks, counted from that start, landed that many segments early. */
+static int64_t vod_start_seq_no(HLSContext *c, struct playlist *pls)
+{
+    const struct playlist *named = pls->time_offset_flag ? pls : NULL;
+    int64_t duration = 0, offset, start = 0;
+    int i;
+
+    for (i = 0; !named && i < c->n_playlists; i++)
+        if (c->playlists[i]->finished && c->playlists[i]->time_offset_flag)
+            named = c->playlists[i];
+    if (!c->vod_x_start || (!named && !c->master_time_offset_flag) || !pls->n_segments)
+        return pls->start_seq_no;
+
+    for (i = 0; i < pls->n_segments; i++)
+        duration = av_sat_add64(duration, pls->segments[i]->duration);
+    offset = named ? named->start_time_offset : c->master_start_offset;
+    if (offset < 0)
+        offset = FFMAX(av_sat_add64(duration, offset), 0);
+    offset = FFMIN(offset, duration);
+
+    for (i = 0; i < pls->n_segments - 1; i++) {
+        if (av_sat_add64(start, pls->segments[i]->duration) > offset)
+            break;
+        start = av_sat_add64(start, pls->segments[i]->duration);
+    }
+    if (i)
+        av_log(pls->parent, AV_LOG_VERBOSE,
+               "Playlist %d starts at segment %"PRId64" (%.3f s), its #EXT-X-START\n",
+               pls->index, pls->start_seq_no + i, start / (double)AV_TIME_BASE);
+    return pls->start_seq_no + i;
+}
+
