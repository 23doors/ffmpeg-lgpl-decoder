+/* Whether a segment that failed its retries fails the playlist rather than
+ * being skipped. A live playlist moves on without the segment; a finished one
+ * would just play on with a gap. With seg_skip=live, a live playlist whose
+ * segments have all failed for live_reload_timeout returns the error too, as
+ * its reloads would: skipping on would read nothing, without end. */
+static int segment_failure_is_final(HLSContext *c, struct playlist *v)
+{
+    return c->seg_skip == SEG_SKIP_NEVER ||
+           (c->seg_skip == SEG_SKIP_LIVE && v->finished) ||
+           (c->seg_skip == SEG_SKIP_LIVE &&
+            av_gettime_relative() - v->segment_error_time >= live_reload_timeout(v, c));
+}
+
 static int read_playlist_data(void *opaque, uint8_t *buf, int buf_size)
 {
     struct playlist *v = opaque;
@@ -1984,6 +2002,17 @@ restart:
          * that long. */
         int64_t open_start = av_gettime_relative();
 
+        /* A segment whose early open failed and that left the playlist before
+         * it was due counts as failed and skipped. */
+        if (v->input_next_error && v->input_next_seq_no < v->cur_seq_no &&
+            segment_failure_is_final(c, v)) {
+            av_log(v->parent, AV_LOG_ERROR, "Segment %"PRId64" of playlist %d failed too many times: %s\n",
+                   v->input_next_seq_no, v->index, av_err2str(v->input_next_error));
+            ret = v->input_next_error;
+            v->input_next_error = 0;
+            return ret;
+        }
+
         /* load/update Media Initialization Section, if any */
         ret = update_init_section(v, seg);
