     int64_t live_reload_timeout;
+    int subtitle_follow_media;      /* VOD subtitle playlists read along the media's segment */
     AVIOContext *playlist_pb;
     HLSCryptoContext  crypto_ctx;
 
@@ -2724,6 +2730,90 @@ static void unwrap_cue_pts(HLSContext *c, struct playlist *v, AVPacket *pkt)
     v->last_cue_pts = pkt->pts;
 }
 
+/* The longest wait before a failed VOD subtitle segment is asked for again. */
+#define SUBTITLE_VOD_RETRY_MAX (4 * AV_TIME_BASE)
+
+/* The start of a segment on its playlist's own time line: the durations of
+ * the segments before it. */
+static int64_t segment_start_time(const struct playlist *pls, int64_t seq_no)
+{
+    int64_t t = 0;
+
+    for (int64_t k = 0; k < seq_no - pls->start_seq_no && k < pls->n_segments; k++)
+        t = av_sat_add64(t, pls->segments[k]->duration);
+    return t;
+}
+
+/* The VOD media playlist a VOD subtitle playlist follows: the first one read. */
+static struct playlist *followed_media_playlist(HLSContext *c)
+{
+    for (int i = 0; i < c->n_playlists; i++) {
+        struct playlist *pls = c->playlists[i];
+
+        if (!pls->is_subtitle && pls->needed && pls->finished && pls->n_segments)
+            return pls;
+    }
+    return NULL;
+}
+
+/* A VOD subtitle playlist is read with the media, in the same call: it asks
+ * only for segments the media has reached, which the server has (a
+ * transcoder holds a request ahead of its progress, and a held subtitle
+ * request held the media), and starts at the media's segment, not at the
+ * playlist's start (a transcode started at an offset lists hundreds of empty
+ * segments before it). Both playlists' segments are matched by their start on
+ * the playlists' time lines (Plex and Jellyfin cut both alike). Returns 0 to
+ * open the subtitle playlist's current segment, AVERROR(EAGAIN) to wait for
+ * the media. */
+static int follow_media_segment(HLSContext *c, struct playlist *v)
+{
+    struct playlist *media;
+    int64_t media_start, start, slack_start;
+    int64_t idx;
+
+    if (!c->subtitle_follow_media || !v->finished || !(media = followed_media_playlist(c)))
+        return 0;
+    media_start = segment_start_time(media, media->cur_seq_no);
+    /* The media may have read into its next segment: one segment before
+     * it is kept. */
+    slack_start = segment_start_time(media, FFMAX(media->cur_seq_no - 1, media->start_seq_no));
+
+    idx = v->cur_seq_no - v->start_seq_no;
+    if (idx < 0 || idx >= v->n_segments)
+        return 0;
+    start = segment_start_time(v, v->cur_seq_no);
+    /* Placed where the media is when opened, selected again or after a seek.
+     * Later it reads on in order, also behind the media after a failed
+     * segment: the media's read-ahead is still to be played. */
+    if (v->subtitle_follow_media) {
+        v->subtitle_follow_media = 0;
+        /* back to the segment holding the media's previous one's start */
+        while (idx > 0 && start > slack_start) {
+            idx--;
+            start -= v->segments[idx]->duration;
+        }
+        /* skip the segments that end before it */
+        while (idx < v->n_segments - 1 &&
+               av_sat_add64(start, v->segments[idx]->duration) <= slack_start) {
+            start = av_sat_add64(start, v->segments[idx]->duration);
+            idx++;
+        }
+        if (v->start_seq_no + idx != v->cur_seq_no) {
+            av_log(v->parent, AV_LOG_VERBOSE,
+                   "Subtitle playlist %d moves from segment %"PRId64" to %"PRId64
+                   " with the media\n", v->index, v->cur_seq_no, v->start_seq_no + idx);
+            v->cur_seq_no = v->start_seq_no + idx;
+        }
+    }
+    /* Not ahead of the media: half a target duration covers segments cut
+     * apart by a frame. A media playlist read to its end lets every one
+     * through. */
+    if (media->cur_seq_no - media->start_seq_no < media->n_segments &&
+        start > av_sat_add64(media_start, media->target_duration / 2))
+        return AVERROR(EAGAIN);
+    return 0;
+}
+
 static int read_subtitle_packet(struct playlist *v, AVPacket *pkt)
 {
     HLSContext *c = v->parent->priv_data;
@@ -2747,6 +2837,8 @@ restart:
