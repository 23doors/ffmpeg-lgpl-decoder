     if (!v->input && !v->ctx) {
+        if (follow_media_segment(c, v) < 0)
+            return AVERROR_EOF;
         /* nothing is repeated across a discontinuity */
         seg = current_segment(v);
         if (seg && seg->discontinuity_seq != v->cues_discontinuity_seq) {
@@ -2790,17 +2882,27 @@ restart:
     FFSWAP(int, v->n_prev_cues, v->n_cur_cues);
     v->prev_cue_pos = 0;
 
-    /* The subtitles are read in the same call as the media: after a live
+    /* The subtitles are read in the same call as the media: after a
      * segment that failed (its request given up after 2 s), the next one is
