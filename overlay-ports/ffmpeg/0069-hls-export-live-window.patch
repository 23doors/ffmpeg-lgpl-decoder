+/* Where the playlist's first listed segment starts. For a live playlist with
+ * an anchor, on the packet timeline from the anchor; otherwise the timeline
+ * start (c->first_timestamp), which only follows the window of the playlist
+ * that set it and only by the segments its previous load listed. */
+static int64_t playlist_start_timestamp(HLSContext *c, struct playlist *pls)
+{
+    if (!pls->finished && pls->anchor_ts != AV_NOPTS_VALUE) {
+        int64_t idx = pls->anchor_seq_no - pls->start_seq_no, before = 0;
+        if (idx < 0) {
+            /* The anchor segment has expired from the list: estimate. */
+            before = idx * pls->target_duration;
+        } else {
+            for (int64_t i = 0; i < idx && i < pls->n_segments; i++)
+                before += pls->segments[i]->duration;
+        }
+        return pls->anchor_ts - before;
+    }
+    return c->first_timestamp == AV_NOPTS_VALUE ? 0 : c->first_timestamp;
+}
