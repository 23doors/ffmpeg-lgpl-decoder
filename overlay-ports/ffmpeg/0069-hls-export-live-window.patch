+/* The playlist the exported live window describes: the one being read (needed,
+ * video first), whose window is where reading and seeking happen. A playlist
+ * whose streams are all discarded is not reloaded, so its window stands still. */
+static struct playlist *live_window_playlist(HLSContext *c)
+{
+    struct playlist *fallback = NULL;
+
+    for (int i = 0; i < c->n_playlists; i++) {
+        struct playlist *pls = c->playlists[i];
+        if (!pls->needed || pls->is_subtitle || !pls->n_segments)
+            continue;
+        for (int j = 0; j < pls->n_main_streams; j++)
+            if (pls->main_streams[j]->codecpar->codec_type == AVMEDIA_TYPE_VIDEO &&
+                pls->main_streams[j]->discard < AVDISCARD_ALL)
+                return pls;
+        if (!fallback)
+            fallback = pls;
+    }
+    if (fallback)
+        return fallback;
+    if (c->first_timestamp_pls)
+        return c->first_timestamp_pls;
+    return c->n_playlists ? c->playlists[0] : NULL;
+}
+
+static void update_live_window(HLSContext *c)
+{
+    struct playlist *pls = live_window_playlist(c);
+    int64_t start, listed = 0, remaining = 0, current;
+
+    if (!pls)
+        return;
+    start   = playlist_start_timestamp(c, pls);
+    current = pls->cur_seq_no - pls->start_seq_no;
+    for (int i = 0; i < pls->n_segments; i++) {
+        listed += pls->segments[i]->duration;
+        if (i > current)
+            remaining += pls->segments[i]->duration;
+    }
+    c->live_playlist_type    = pls->type == PLS_TYPE_EVENT ? 1 : pls->type == PLS_TYPE_VOD ? 2 : 0;
+    c->live_finished         = pls->finished;
+    c->live_target_duration  = pls->target_duration;
+    c->live_window_start     = start + c->ts_shift;
+    c->live_window_end       = start + listed + c->ts_shift;
+    c->live_window_remaining = remaining;
+    c->live_media_sequence   = pls->start_seq_no;
+    c->live_playlist_age     = pls->last_load_time > 0 ?
+                               FFMAX(av_gettime_relative() - pls->last_load_time, 0) : 0;
+}
