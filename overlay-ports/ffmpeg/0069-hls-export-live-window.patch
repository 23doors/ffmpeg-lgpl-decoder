+/* The segment of `pls` as far from its live end as `seq_no` is from the end
+ * of `ref` (renditions of one stream share their segmentation). */
+static int64_t seq_no_at_same_distance_from_end(struct playlist *pls, struct playlist *ref,
+                                                int64_t seq_no)
+{
+    int64_t distance = ref->start_seq_no + ref->n_segments - seq_no;
+    int64_t mapped   = pls->start_seq_no + pls->n_segments - distance;
+    return av_clip64(mapped, pls->start_seq_no,
+                     pls->start_seq_no + FFMAX(pls->n_segments - 1, 0));
+}
+
+/* Where a live playlist starts playing: live_start_index from the end (or start). */
+static int64_t live_start_seq_no(HLSContext *c, struct playlist *pls)
+{
+    if (c->live_start_index < 0)
+        return pls->start_seq_no + FFMAX(pls->n_segments + c->live_start_index, 0);
+    return pls->start_seq_no + FFMIN(c->live_start_index, FFMAX(pls->n_segments - 1, 0));
+}
